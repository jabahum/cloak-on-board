APP_NAME=keycloak-onboarder
APP_ENV=development
APP_PORT=9000

DATABASE_URL=postgres://postgres:postgres@postgres:5432/onboarder?sslmode=disable


POSTGRES_DB=onboarder
POSTGRES_USER=onboarder_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=onboarder
KEYCLOAK_AUDIENCE=keycloak-onboarder-ui
KEYCLOAK_ADMIN_CLIENT_ID=onboarder-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
CREDENTIAL_ENCRYPTION_KEYS=v1:BASE64_ENCODED_32_BYTE_KEY
SECRET_DELIVERY_TTL_MINUTES=10
DRIFT_CHECK_INTERVAL_MINUTES=0
AUTH_MODE=keycloak


ALLOWED_ORIGINS=https://localhost
VITE_API_BASE_URL=https://localhost/api/v1
